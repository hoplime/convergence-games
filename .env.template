# =============================================================================
# Convergence Games — Local Development Environment
# =============================================================================
# Copy this file to .env and fill in the values.
#
#   cp .env.template .env
#
# All settings have sensible defaults for local development unless marked
# REQUIRED. See src/convergence_games/settings.py for the full list.
# =============================================================================

# -- Database (matches compose.dev.yaml) --------------------------------------
DATABASE_USERNAME=convergence
DATABASE_PASSWORD=convergence
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=convergence

# -- General ------------------------------------------------------------------
DEBUG=true

# -- Event --------------------------------------------------------------------
# ID of the default event to load (must exist in the database).
# Set to 1 for a fresh database after running create_mock_data, or to the
# actual event ID after importing fixtures.
DEFAULT_EVENT_ID=1
SITE_TITLE=Convergence Dev

# -- Image storage (filesystem for local dev) ---------------------------------
IMAGE_STORAGE_MODE=filesystem
IMAGE_STORAGE_PATH=src/convergence_games/static/images/uploads

# -- Auth secrets (REQUIRED — generate your own) ------------------------------
# Fernet key for encrypting OAuth state. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIGNING_KEY=
# JWT token secret. Any random string works. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET=

# -- OAuth providers (optional — leave blank to disable that provider) --------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# -- Email (optional — leave blank to disable email sign-in) ------------------
BREVO_API_KEY=

# -- Sentry (optional — disabled when DSN is blank) --------------------------
SENTRY_ENABLE=false
SENTRY_DSN=
